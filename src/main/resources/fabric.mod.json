{
	"schemaVersion": 1,
	"id": "huntcraft",
	"version": "${version}",
	"name": "HuntCraft",
	"description": "헌팅 액션 전투 (태도 + 대형 몬스터 1:1)",
	"authors": ["siwoo"],
	"license": "All-Rights-Reserved",
	"environment": "*",
	"entrypoints": {
		"main": ["kr.huntcraft.HuntCraft"],
		"client": ["kr.huntcraft.client.HuntCraftClient"]
	},
	"mixins": [
		{ "config": "huntcraft.client.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"geckolib": ">=${geckolib_version}",
		"player_animation_library": "*"
	}
}
